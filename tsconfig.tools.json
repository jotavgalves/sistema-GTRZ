{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": ".types/tools",
    "rootDir": ".",
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "vitest.config.ts",
    "tests/**/*.ts",
    "packages/**/*.spec.ts"
  ],
  "references": [
    { "path": "./packages/contracts" },
    { "path": "./packages/domain" },
    { "path": "./packages/database" }
  ]
}
