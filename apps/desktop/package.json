{
  "name": "@gtrz/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@gtrz/contracts": "*",
    "@gtrz/database": "*",
    "@gtrz/domain": "*",
    "better-sqlite3": "13.0.1",
    "lucide-react": "1.27.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.4",
    "electron-vite": "5.0.0",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "br.com.gtrz.system",
    "productName": "GTRZ System",
    "asar": true,
    "npmRebuild": true,
    "directories": {
      "output": "../../release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/branding",
        "to": "branding",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "GTRZ-System-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GTRZ System"
    }
  }
}
